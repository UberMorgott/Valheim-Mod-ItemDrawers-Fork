<Project>
  <PropertyGroup>
    <!--
      Path to your local Valheim install (the folder containing valheim.exe,
      valheim_Data\Managed and BepInEx). Game, Unity, BepInEx and Jotunn
      (BepInEx\plugins\Jotunn\Jotunn.dll) are referenced from there with
      Private=false; they are never committed to the repo.
    -->
    <ValheimDir>C:\Path\To\Steam\steamapps\common\Valheim</ValheimDir>
  </PropertyGroup>
</Project>