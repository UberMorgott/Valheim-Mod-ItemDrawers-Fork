<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>ItemDrawers</AssemblyName>
    <RootNamespace>ItemDrawers.Game</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Version>1.0.0</Version>
    <!-- build/Valheim.Build.props: the game's own BepInEx/0Harmony, Jotunn from the game's
         plugins folder, the publicizer, and Morgott.Core pinned in build/ref (refs.lock). -->
    <ValheimPlugin>true</ValheimPlugin>
    <ValheimUseJotunn>true</ValheimUseJotunn>
    <ValheimUsePublicizer>true</ValheimUsePublicizer>
    <ValheimUseCore>true</ValheimUseCore>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ItemDrawers.Core\ItemDrawers.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.8" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <!--
    UnityEngine.Modules is not used: Valheim 1.0 runs on Unity 6000.0.75f1, and the
    UnityEngine.Modules NuGet package (nuget.org) only goes up to 2021.3.33 — nowhere
    close. The actual UnityEngine module DLLs shipped next to the game are referenced
    instead. Localization lives in assembly_guiutils, not assembly_valheim: an easy
    assumption to get wrong since every other gameplay type is in assembly_valheim.
  -->
  <ItemGroup>
    <Reference Include="assembly_valheim" HintPath="$(ManagedDir)\assembly_valheim.dll" Private="false" Publicize="true" />
    <Reference Include="assembly_utils" HintPath="$(ManagedDir)\assembly_utils.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(ManagedDir)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="$(ManagedDir)\UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(ManagedDir)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(ManagedDir)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="assembly_guiutils" HintPath="$(ManagedDir)\assembly_guiutils.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(ManagedDir)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(ManagedDir)\UnityEngine.UI.dll" Private="false" />
  </ItemGroup>
</Project>